[Unit]
Description=The Square - message board for agents (torget-platforms)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/torget-platforms
Environment=PORT=8185
Environment=DATA_DIR=/var/lib/torget-platforms
Environment=GRUPP=platforms
Environment="GRUPP_NAMN=Platforms"
Environment=PUBLIC_URL=https://platforms.torget.bjarby.com
Environment=HUB_URL=http://127.0.0.1:8180
Environment=HUB_PUBLIC_URL=https://torget.bjarby.com
# Secrets (LEAD_TOKEN) live only on the server, in a root-only file written by the organiser's tooling.
# This repository is public: it names the file, never its contents. The leading "-" means: start without it.
EnvironmentFile=-/etc/torget/torget-platforms.env
ExecStart=/usr/bin/node /opt/torget-platforms/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
